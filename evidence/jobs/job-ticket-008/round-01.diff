+// A point in time written as seconds since 1970 or as `YYYY-MM-DD[T ]HH:MM[:SS][Z|±HH:MM]`.
+fn timestamp(text: &str) -> Option<SystemTime> {
+    let text = text.trim();
+    if text.len() >= 9 && text.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Some(UNIX_EPOCH + Duration::from_secs(text.parse().ok()?));
+    }
+    let number = |part: &str| -> Option<i64> {
+        (!part.is_empty() && part.bytes().all(|byte| byte.is_ascii_digit()))
+            .then(|| part.parse().ok())?
+    };
+    let (date, time) = text.split_once(['T', ' '])?;
+    let mut date = date.split('-');
+    let (year, month, day) = (
+        number(date.next()?)?,
+        number(date.next()?)?,
+        number(date.next()?)?,
+    );
+    if date.next().is_some() || !(1..=12).contains(&month) || !(1..=31).contains(&day) {
+        return None;
+    }
+    let (clock, offset) = if let Some(clock) = time.strip_suffix(['Z', 'z']) {
+        (clock, 0)
+    } else if let Some(at) = time.rfind(['+', '-']) {
+        let (clock, zone) = time.split_at(at);
+        let sign = if zone.starts_with('-') { -1 } else { 1 };
+        let zone = zone[1..].replace(':', "");
+        if zone.len() != 4 || !zone.bytes().all(|byte| byte.is_ascii_digit()) {
+            return None;
+        }
+        (
+            clock,
+            sign * (number(&zone[..2])? * 3600 + number(&zone[2..])? * 60),
+        )
+    } else {
+        (time, 0)
+    };
+    let clock = clock.split('.').next()?;
+    let mut clock = clock.split(':');
+    let hour = number(clock.next()?)?;
+    let minute = number(clock.next()?)?;
+    let second = clock.next().map_or(Some(0), number)?;
+    if clock.next().is_some() || hour > 23 || minute > 59 || second > 60 {
+        return None;
+    }
+    // Days since 1970-01-01 in the proleptic Gregorian calendar.
+    let shifted = if month <= 2 { year - 1 } else { year };
+    let era = shifted.div_euclid(400);
+    let of_era = shifted - era * 400;
+    let of_year = (153 * ((month + 9) % 12) + 2) / 5 + day - 1;
+    let of_cycle = of_era * 365 + of_era / 4 - of_era / 100 + of_year;
+    let days = era * 146_097 + of_cycle - 719_468;
+    let seconds = days * 86_400 + hour * 3600 + minute * 60 + second - offset;
+    Some(UNIX_EPOCH + Duration::from_secs(u64::try_from(seconds).ok()?))
+}
