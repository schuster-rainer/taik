+#[test]
+fn a_failing_gate_author_is_marked_avoided_and_cleared() {
+    let root = tempfile::Builder::new()
+        .prefix("taik-failed-")
+        .tempdir_in("/tmp")
+        .unwrap();
+    let root = root.path().canonicalize().unwrap();
+    let state = root.join("state");
+    fs::create_dir_all(state.join("jobs")).unwrap();
+    // pruefer fails while the file `broken` exists; ersatz always answers.
+    agent(&state, "pruefer", "kaputt");
+    agent(&state, "ersatz", "m");
+    fs::write(
+        root.join("plan.json"),
+        reply("Art: dokument\nRepo: -\nGate: pruefer\nArbeit: standard\nGrund: Pruefer schreibt die Prüfung."),
+    )
+    .unwrap();
+    fs::write(
+        root.join("files.json"),
+        reply("=== brief.md ===\nEine Seite mit Titel bauen\n\n=== verify.mjs ===\nconsole.log('PASS');\n"),
+    )
+    .unwrap();
+    let worker = root.join("lead");
+    executable(
+        &worker,
+        &format!(
+            "#!/bin/sh\ncase \"$*\" in *'--model kaputt'*) test -f '{0}/broken' && exit 1;; esac\ncase \"$*\" in *'orchestrator of a software factory'*) cat '{0}/plan.json';; *) cat '{0}/files.json';; esac\n",
+            root.display()
+        ),
+    );
+    fs::copy(&worker, root.join("claude")).unwrap();
+    fs::write(root.join("broken"), "").unwrap();
+    let marker = state.join("crew/pruefer.failed");
+
+    // 1. The named gate author fails: the service marks it, another agent writes the gate.
+    assert_eq!(request(&state, "Eine Seite"), "ticket-001");
+    let served = drain(&state, &root, &worker);
+    let message = fs::read_to_string(&marker).unwrap_or_else(|_| panic!("{served:?}"));
+    assert_eq!(message.lines().count(), 1, "{message}");
+    assert!(!message.trim().is_empty());
+    let origin = fs::read_to_string(state.join("proposals/ticket-001/origin.txt")).unwrap();
+    assert!(origin.contains("proposed_by=ersatz\n"), "{origin}");
+    assert!(!state.join("crew/standard.failed").exists());
+    assert!(!state.join("crew/ersatz.failed").exists());
+
+    // 2. The assignment shows it, and the orchestrator moves its gate to another agent.
+    let shown = orchestrator_prompt(&state, &state.join("requests/ticket-001.run"), &worker);
+    let text = String::from_utf8(shown.stdout).unwrap();
+    assert!(
+        text.lines()
+            .any(|line| line.starts_with("- pruefer: ") && line.ends_with(" (failed recently)")),
+        "{text}"
+    );
+    assert!(
+        text.lines()
+            .any(|line| line.starts_with("- ersatz: ") && !line.contains("failed")),
+        "{text}"
+    );
+    assert_eq!(request(&state, "Noch eine Seite"), "ticket-002");
+    let served = drain(&state, &root, &worker);
+    let plan = fs::read_to_string(state.join("requests/ticket-002.plan"))
+        .unwrap_or_else(|_| panic!("{served:?}"));
+    assert!(plan.contains("gate=ersatz\n"), "{plan}");
+    assert!(
+        plan.contains("@pruefer") && plan.contains("@ersatz"),
+        "{plan}"
+    );
+    assert!(marker.exists());
+
+    // 3. Six hours later the agent is chosen again, delivers a gate, and the marker is gone.
+    fs::remove_file(root.join("broken")).unwrap();
+    age(&marker, 7);
+    assert_eq!(request(&state, "Eine dritte Seite"), "ticket-003");
+    let served = drain(&state, &root, &worker);
+    let plan = fs::read_to_string(state.join("requests/ticket-003.plan"))
+        .unwrap_or_else(|_| panic!("{served:?}"));
+    assert!(plan.contains("gate=pruefer\n"), "{plan}");
+    let origin = fs::read_to_string(state.join("proposals/ticket-003/origin.txt"))
+        .unwrap_or_else(|_| panic!("{served:?}"));
+    assert!(origin.contains("proposed_by=pruefer\n"), "{origin}");
+    assert!(!marker.exists(), "{served:?}");
+}
+
+#[test]
+fn the_standard_worker_is_never_marked() {
+    let root = tempfile::Builder::new()
+        .prefix("taik-standard-")
+        .tempdir_in("/tmp")
+        .unwrap();
+    let root = root.path().canonicalize().unwrap();
+    let state = root.join("state");
+    fs::create_dir_all(state.join("jobs")).unwrap();
+    fs::write(
+        root.join("plan.json"),
+        reply("Art: dokument\nRepo: -\nGate: standard\nArbeit: standard\nGrund: Einfach."),
+    )
+    .unwrap();
+    // It plans, then fails to write the gate.
+    let worker = root.join("lead");
+    executable(
+        &worker,
+        &format!(
+            "#!/bin/sh\ncase \"$*\" in *'orchestrator of a software factory'*) cat '{}/plan.json';; *) exit 1;; esac\n",
+            root.display()
+        ),
+    );
+    assert_eq!(request(&state, "Eine Seite"), "ticket-001");
+    let served = drain(&state, &root, &worker);
+    assert!(
+        state.join("requests/ticket-001.failed").exists(),
+        "{served:?}"
+    );
+    assert!(!state.join("crew/standard.failed").exists());
+    let marked = fs::read_dir(state.join("crew"))
+        .into_iter()
+        .flatten()
+        .flatten()
+        .any(|entry| entry.file_name().to_string_lossy().ends_with(".failed"));
+    assert!(!marked);
+}
