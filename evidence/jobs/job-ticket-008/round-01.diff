+#![cfg(target_os = "macos")]
+
+use std::fs;
+use std::os::unix::fs::PermissionsExt;
+use std::path::Path;
+use std::process::{Command, Output};
+use std::time::{Duration, SystemTime};
+
+fn factory() -> Command {
+    Command::new(env!("CARGO_BIN_EXE_taik-seed"))
+}
+
+fn agent(state: &Path, name: &str, model: &str) {
+    fs::create_dir_all(state.join("crew")).unwrap();
+    fs::write(
+        state.join(format!("crew/{name}.agent")),
+        format!("harness=claude\nmodel={model}\neffort=low\npersona=\nend\n"),
+    )
+    .unwrap();
+}
+
+fn age(path: &Path, hours: u64) {
+    fs::File::options()
+        .write(true)
+        .open(path)
+        .unwrap()
+        .set_modified(SystemTime::now() - Duration::from_secs(hours * 60 * 60))
+        .unwrap();
+}
+
+fn executable(path: &Path, text: &str) {
+    fs::write(path, text).unwrap();
+    fs::set_permissions(path, fs::Permissions::from_mode(0o700)).unwrap();
+}
+
+fn reply(text: &str) -> String {
+    serde_json::json!({"type": "result", "is_error": false, "result": text,
+        "usage": {"output_tokens": 1}, "total_cost_usd": 0.01, "modelUsage": {"m": {}}})
+    .to_string()
+}
+
+fn request(state: &Path, text: &str) -> String {
+    use std::io::Write;
+    use std::process::Stdio;
+    let mut child = factory()
+        .arg("request")
+        .arg(state)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .spawn()
+        .unwrap();
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(text.as_bytes())
+        .unwrap();
+    let output = child.wait_with_output().unwrap();
+    assert!(output.status.success(), "{output:?}");
+    String::from_utf8_lossy(&output.stdout).trim().to_owned()
+}
+
+fn drain(state: &Path, root: &Path, worker: &Path) -> Output {
+    factory()
+        .arg("drain")
+        .arg(state)
+        .env("TAIK_LEAD_WORKER", worker)
+        .env(
+            "PATH",
+            format!("{}:{}", root.display(), std::env::var("PATH").unwrap()),
+        )
+        .env_remove("TAIK_SECOND_WORKER")
+        .env_remove("TAIK_AUTO_PROPOSE")
+        .output()
+        .unwrap()
+}
+
+fn orchestrator_prompt(state: &Path, request: &Path, worker: &Path) -> Output {
+    factory()
+        .arg("orchestrator-prompt")
+        .arg(state)
+        .arg(request)
+        .env("TAIK_LEAD_WORKER", worker)
+        .output()
+        .unwrap()
+}
+
+#[test]
+fn the_orchestrator_shows_its_assignment_without_calling_a_worker() {
+    let root = tempfile::Builder::new()
+        .prefix("taik-assignment-")
+        .tempdir_in("/tmp")
+        .unwrap();
+    let root = root.path().canonicalize().unwrap();
+    let state = root.join("state");
+    fs::create_dir_all(&state).unwrap();
+    let request = root.join("REQUEST.run");
+    fs::write(
+        &request,
+        "decision=pending\nidentity=gate-check\nintent=Prüfe den Auftragssatz\nobservation=Ein Wunsch\ncontinuation=Test\n",
+    )
+    .unwrap();
+    // A worker that must not be called: it does not exist.
+    let never = root.join("never");
+
+    // Without products, repositories and agents.
+    let empty = orchestrator_prompt(&state, &request, &never);
+    assert_eq!(empty.status.code(), Some(0), "{empty:?}");
+    let empty = String::from_utf8(empty.stdout).unwrap();
+    assert!(empty.starts_with("You are the orchestrator"), "{empty}");
+    assert!(empty.contains("\nPRODUCTS:\n(none)\n"), "{empty}");
+    assert!(empty.contains("\nREPOSITORIES:\n(none)\n"), "{empty}");
+    assert!(empty.ends_with("\nREQUEST OF THE USER:\ndecision=pending\nidentity=gate-check\nintent=Prüfe den Auftragssatz\nobservation=Ein Wunsch\ncontinuation=Test\n"));
+
+    fs::create_dir_all(state.join("products")).unwrap();
+    fs::write(state.join("products/kasse.product"), "about=Kasse\n").unwrap();
+    fs::write(state.join("products/lager.product"), "about=Lager\n").unwrap();
+    for name in ["alpha", "beta"] {
+        fs::create_dir_all(state.join(format!("repositories/{name}/.taik"))).unwrap();
+    }
+    fs::write(
+        state.join("repositories/alpha/.taik/protected"),
+        "# Kommentar\nsrc/secret.rs\n\nCargo.toml\n",
+    )
+    .unwrap();
+    fs::write(state.join("repositories/beta/.taik/protected"), "").unwrap();
+    agent(&state, "gate-author", "m");
+    agent(&state, "other", "m");
+    fs::write(state.join("crew/gate-author.failed"), "kaputt\n").unwrap();
+    fs::write(state.join("crew/other.failed"), "kaputt\n").unwrap();
+    age(&state.join("crew/other.failed"), 7);
+
+    let shown = orchestrator_prompt(&state, &request, &never);
+    assert_eq!(shown.status.code(), Some(0), "{shown:?}");
+    let text = String::from_utf8(shown.stdout).unwrap();
+    assert!(
+        text.contains("\nPRODUCTS:\n- kasse: Kasse\n- lager: Lager\n"),
+        "{text}"
+    );
+    assert!(
+        text.contains("\n- alpha: \n  protected: src/secret.rs, Cargo.toml\n"),
+        "{text}"
+    );
+    assert!(text.contains("\n- beta: \n  protected: (none)\n"), "{text}");
+    let line = |name: &str| {
+        text.lines()
+            .find(|line| line.starts_with(&format!("- {name}: ")))
+            .unwrap_or_else(|| panic!("{text}"))
+            .to_owned()
+    };
+    assert!(line("gate-author").ends_with(" (failed recently)"), "{text}");
+    assert!(!line("other").contains("(failed recently)"), "{text}");
+    assert!(text.contains("A change to a listed product is of kind 'dokument'."));
+    assert!(text.contains("must not change the protected paths"));
+    // Nothing was planned, nothing was recorded.
+    assert!(!root.join("REQUEST.plan").exists());
+    assert!(!root.join("REQUEST.plan.run").exists());
+    assert_eq!(fs::read_dir(&root).unwrap().count(), 2);
+}
