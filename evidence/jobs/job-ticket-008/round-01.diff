+// An agent whose call failed within the last six hours. The time is the one the marker names,
+// otherwise the time it was last written.
+fn failed_recently(home: &Path, name: &str) -> bool {
+    let marker = failed_marker(home, name);
+    let Ok(metadata) = fs::symlink_metadata(&marker) else {
+        return false;
+    };
+    if !metadata.is_file() {
+        return false;
+    }
+    let text = record::read_regular(&marker, 4096).unwrap_or_default();
+    let when = timestamp(text.lines().next().unwrap_or(""))
+        .or_else(|| metadata.modified().ok());
+    // A time in the future counts as recent.
+    when.is_some_and(|when| {
+        !matches!(SystemTime::now().duration_since(when), Ok(age) if age >= FAILED_FOR)
+    })
 }
 
