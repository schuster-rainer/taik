+// A zone as `±HHMM`, `±HH:MM`, `±HH`, or a common abbreviation; the offset in seconds.
+fn zone(text: &str) -> Option<i64> {
+    let text = text.trim();
+    match text.to_ascii_uppercase().as_str() {
+        "Z" | "UTC" | "GMT" | "UT" => return Some(0),
+        "CET" | "MEZ" | "BST" => return Some(3600),
+        "CEST" | "MESZ" | "EET" => return Some(7200),
+        "EEST" => return Some(3 * 3600),
+        "EST" => return Some(-5 * 3600),
+        "EDT" | "CDT" => return Some(-4 * 3600 - i64::from(text == "CDT") * 3600),
+        "PST" => return Some(-8 * 3600),
+        "PDT" => return Some(-7 * 3600),
+        _ => {}
+    }
+    let sign = match text.as_bytes().first()? {
+        b'+' => 1,
+        b'-' => -1,
+        _ => return None,
+    };
+    let digits = text[1..].replace(':', "");
+    if !digits.bytes().all(|byte| byte.is_ascii_digit()) {
+        return None;
+    }
+    let (hours, minutes) = match digits.len() {
+        2 => (digits.parse::<i64>().ok()?, 0),
+        4 => (digits[..2].parse().ok()?, digits[2..].parse().ok()?),
+        _ => return None,
+    };
+    Some(sign * (hours * 3600 + minutes * 60))
+}
+
+// `HH:MM[:SS[.fraction]]`.
+fn clock(text: &str) -> Option<[i64; 3]> {
+    let mut parts = text.trim().split('.').next()?.split(':');
+    let mut next = || -> Option<i64> {
+        let part = parts.next()?;
+        (!part.is_empty() && part.bytes().all(|byte| byte.is_ascii_digit()))
+            .then(|| part.parse().ok())?
+    };
+    let hour = next()?;
+    let minute = next()?;
+    let second = next().unwrap_or(0);
+    next().is_none().then_some([hour, minute, second])
+}
