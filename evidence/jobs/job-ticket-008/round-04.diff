+// The form of `date` and of mail headers, also with German month names.
+fn words(text: &str) -> Option<SystemTime> {
+    const MONTHS: [&[&str]; 12] = [
+        &["jan"],
+        &["feb"],
+        &["mar", "mär", "mrz"],
+        &["apr"],
+        &["may", "mai"],
+        &["jun"],
+        &["jul"],
+        &["aug"],
+        &["sep"],
+        &["oct", "okt"],
+        &["nov"],
+        &["dec", "dez"],
+    ];
+    let (mut year, mut month, mut day, mut time, mut offset) = (None, None, None, None, 0);
+    for token in text
+        .split(|c: char| c.is_whitespace() || c == ',')
+        .filter(|token| !token.is_empty())
+    {
+        let lower = token.to_lowercase();
+        let digits = token.bytes().all(|byte| byte.is_ascii_digit());
+        if token.contains(':') && time.is_none() {
+            time = Some(clock(token)?);
+        } else if digits && token.len() == 4 {
+            year = token.parse().ok();
+        } else if digits && token.len() <= 2 {
+            day = token.trim_end_matches('.').parse().ok();
+        } else if let Some(found) = MONTHS
