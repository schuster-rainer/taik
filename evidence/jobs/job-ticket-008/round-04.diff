+            .filter(|_| month.is_none() && lower.chars().all(char::is_alphabetic))
+        {
+            month = Some(found as i64 + 1);
+        } else if let Some(found) = zone(token) {
+            offset = found;
+        }
+    }
+    civil([year?, month?, day?], time?, offset)
+}
