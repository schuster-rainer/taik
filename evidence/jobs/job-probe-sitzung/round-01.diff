-// Returns a greeting for a name.
+// Liefert einen deutschen Gruß für einen Namen.
+// Fehlt der Name oder ist er leer bzw. nur aus Leerzeichen, wird "Welt" begrüßt.
 export function greet(name) {
-  return 'Hello, ' + name + '!';
+  const trimmed = typeof name === 'string' ? name.trim() : '';
+  return 'Hallo, ' + (trimmed === '' ? 'Welt' : trimmed) + '!';
 }
