 use std::path::PathBuf;
 use std::process::ExitCode;
 
+const HILFE: &str = concat!(
+    "Aufruf: auftragsbericht [--offen] [--json] ORDNER\n",
+    "  --offen  nur Aufträge zeigen, deren letzte Entscheidung nicht accepted ist\n",
+    "  --json   den Bericht als JSON-Objekt ausgeben\n",
+    "  --hilfe  diesen Hilfetext ausgeben und beenden\n",
+);
+
 fn main() -> ExitCode {
+    // --hilfe hat Vorrang vor allem anderen (bis zu einem etwaigen "--").
+    let hilfe = env::args_os()
+        .skip(1)
+        .take_while(|a| a != "--")
+        .any(|a| a == "--hilfe");
+    if hilfe {
+        let mut aus = io::stdout().lock();
+        if aus.write_all(HILFE.as_bytes()).and_then(|_| aus.flush()).is_err() {
+            return ExitCode::from(1);
+        }
+        return ExitCode::SUCCESS;
+    }
+
