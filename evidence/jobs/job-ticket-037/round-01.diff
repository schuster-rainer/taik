+const HILFE: &str = "Aufruf: auftragsbericht [--offen] [--json] ORDNER\n\
+  \x20 --offen  nur Aufträge zeigen, deren letzte Entscheidung nicht accepted ist\n\
+  \x20 --json   den Bericht als JSON-Objekt ausgeben\n\
+  \x20 --hilfe  diesen Hilfetext ausgeben und beenden\n";
+
+fn pruefe_hilfe(args: &[&std::ffi::OsStr]) {
+    let aus = starte(args);
+    assert_eq!(aus.status.code(), Some(0), "{:?} {:?}", args, aus);
+    assert!(aus.stderr.is_empty(), "{:?} {:?}", args, aus);
+    assert_eq!(String::from_utf8(aus.stdout).unwrap(), HILFE, "{:?}", args);
+}
+
+#[test]
+fn hilfe_allein() {
+    let aus = starte(&[os("--hilfe")]);
+    let stdout = String::from_utf8(aus.stdout.clone()).unwrap();
+    let zeilen: Vec<&str> = stdout.split_inclusive('\n').collect();
+    assert_eq!(zeilen.len(), 4);
+    assert!(zeilen.iter().all(|z| z.ends_with('\n')));
+    assert_eq!(zeilen[0], "Aufruf: auftragsbericht [--offen] [--json] ORDNER\n");
+    assert!(zeilen[1].contains("--offen"));
+    assert!(zeilen[2].contains("--json"));
+    assert!(zeilen[3].contains("--hilfe"));
+    pruefe_hilfe(&[os("--hilfe")]);
+}
+
+#[test]
+fn hilfe_mit_anderen_argumenten() {
+    let t = TempOrdner::neu();
+    let w = &t.0;
+    json_beispiel(w);
+    let fehlt = w.join("gibt-es-nicht");
+    let datei = w.join("datei");
+    fs::write(&datei, "x").unwrap();
+
+    pruefe_hilfe(&[os("--hilfe"), w.as_os_str()]);
+    pruefe_hilfe(&[w.as_os_str(), os("--hilfe")]);
+    pruefe_hilfe(&[os("--offen"), os("--hilfe"), w.as_os_str()]);
+    pruefe_hilfe(&[os("--json"), os("--offen"), w.as_os_str(), os("--hilfe")]);
+    pruefe_hilfe(&[os("--hilfe"), w.as_os_str(), fehlt.as_os_str()]);
+    pruefe_hilfe(&[fehlt.as_os_str(), os("--hilfe")]);
+    pruefe_hilfe(&[datei.as_os_str(), os("--hilfe")]);
+    pruefe_hilfe(&[os("--zu"), os("--hilfe")]);
+    pruefe_hilfe(&[os("--hilfe"), os("-x"), os("--offen=ja")]);
+    pruefe_hilfe(&[os("--hilfe"), os("--hilfe")]);
+
+    // ohne --hilfe unverändert
+    let aus = starte(&[os("--zu")]);
+    assert_eq!(aus.status.code(), Some(2));
+    assert!(aus.stdout.is_empty());
+    assert_eq!(
+        String::from_utf8_lossy(&aus.stderr),
+        "Aufruf: auftragsbericht ORDNER\n"
+    );
+}
