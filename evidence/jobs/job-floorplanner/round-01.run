checks=' +     '    const occupied = new Set(), ids = new Set();\n' +     '    const key = (x,y)=>y*width+x;\n' +     '    for (const fixture of fixtures) {\n' +     '      if (!fixture) return invalid;\n' +     '      const {id,x,y,w,d} = fixture;\n' +     '      if (![x,y,w,d].every(Number.isInteger) || x<0 || y<0 || w<1 || d<1 ||\n' +     '          x+w>width || y+d>depth || ids.has(id)) return invalid;\n' +     '      ids.add(id);\n' +     '      for (let row=y;row<y+d;row++) {\n' +     '        for (let col=x;col<x+w;col++) {\n' +     '          const cell = key(col,row);\n' +     '          if (occupied.has(cell)) return invalid;\n' +     '          occupied.add(cell);\n' +     '        }\n' +     '      }\n' +     '    }\n' +     '    const free = (x,y)=>Number.isInteger(x) && Number.isInteger(y) &&\n' +     '      x>=0 && y>=0 && x+1<width && y+1<depth &&\n' +     '      ![key(x,y),key(x+1,y),key(x,y+1),key(x+1,y+1)].some(cell=>occupied.has(cell));\n' +     '    if (![entrance,exit].every(point=>Array.isArray(point) && point.length===2 && free(...point))) return invalid;\n' +     '\n' +     '    const start = key(...entrance), finish = key(...exit);\n' +     '    const queue = [entrance];\n' +     '    const parent = new Map([[start,null]]);\n' +     '    for (let i=0;i<queue.length;i++) {\n' +     '      const [x,y] = queue[i];\n' +     '      const here = key(x,y);\n' +     '      if (here===finish) {\n' +     '        const route = [];\n' +     '        for (let cell=finish;cell!==null;cell=parent.get(cell)) {\n' +     '          route.push([cell%width,Math.floor(cell/width)]);\n' +     '        }\n' +     '        return {valid:true,route:route.reverse()};\n' +     '      }\n' +     '      for (const [dx,dy] of [[1,0],[0,-1],[-1,0],[0,1]]) {\n' +     '        const nx=x+dx, ny=y+dy, next=key(nx,ny);\n' +     '        if (free(nx,ny) && !parent.has(next)) {\n' +     '          parent.set(next,here);\n' +     '          queue.push([nx,ny]);\n' +     '        }\n' +     '      }\n' +     '    }\n' +     '    return invalid;\n' +     '  }\n' +     '\n' +     '  function move(plan,id,x,y) {\n' +     '    const fixture = plan?.fixtures?.find(item=>item.id===id);\n' +     '    if (!fixture || (fixture.x===x && fixture.y===y)) return null;\n' +     '    const next = {...plan,fixtures:plan.fixtures.map(item=>item===fixture?{...item,x,y}:item)};\n' +     '    return validate(next).valid?next:null;\n' +     '  }\n' +     '\n' +     '  function project(x,y) {\n' +     '    return [344+(x-y)*17,65+(x+y)*9];\n' +     '  }\n' +     '\n' +     '  function unproject(screenX,screenY) {\n' +     '    const a=(screenX-344)/17, b=(screenY-65)/9;\n' +     '    return [(a+b)/2,(b-a)/2];\n' +     '  }\n' +     '\n' +     '  globalThis.floorPlan = {initial,validate,move,project,unproject};\n' +     '})();\n' +     '</script>\n' +     '<script>\n' +     '(() => {\n' +     '  const {initial,validate,move,project,unproject}=globalThis.floorPlan;\n' +     '  const $=id=>document.getElementById(id);\n' +     "  const map=$('map'), drawing=$('drawing'), list=$('fixtures'), name=$('name');\n" +     '  const palette={\n' +     "    produce:['Obst & Gemüse','#b8d48a','#749954','#95b66c',19],\n" +     "    bakery:['Backwaren','#efcb91','#ad7e44','#cfa569',24],\n" +     "    shelf:['Regale','#d5ccbb','#8a8174','#ada292',29],\n" +     "    cold:['Kühlung','#b7dce5','#658d9c','#87b3c2',33],\n" +     "    checkout:['Kassen','#e9baae','#a6665a','#ca8f80',20],\n" +     "    storage:['Lager','#c4cfc8','#737f78','#9ca9a0',31],\n" +     "    route:['Laufweg','#168468']\n" +     '  };\n' +     "  let plan=initial(), selected='produce';\n" +     '  for (const [label,color] of Object.values(palette)) {\n' +     "    const item=document.createElement('span'), swatch=document.createElement('i');"... 8011 more characters,   expected: /<(?:script|iframe|link|img|object|embed)\b[^>]*(?:src|href|data|srcdoc)\s*=|https?:\/\//i,   operator: 'doesNotMatch' }  Node.js v2