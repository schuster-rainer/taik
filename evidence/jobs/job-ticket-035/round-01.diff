+fn os(s: &str) -> &std::ffi::OsStr {
+    std::ffi::OsStr::new(s)
+}
+
+fn json_beispiel(w: &Path) {
+    schreibe(
+        &w.join("job-a/round-01.run"),
+        "decision=accepted\nworker_cost_usd=0.1\nsession_listed_usd=0.2\n",
+    );
+    schreibe(
+        &w.join("job-b/round-01.run"),
+        "decision=rejected\nworker_cost_usd=0.5\n",
+    );
+    schreibe(&w.join("job-c/sonst.run"), "worker_cost_usd=1\n");
+}
+
+#[test]
+fn option_json() {
+    let t = TempOrdner::neu();
+    let w = &t.0;
+    json_beispiel(w);
+
+    let aus = starte(&[os("--json"), w.as_os_str()]);
+    assert_eq!(aus.status.code(), Some(0), "{:?}", aus);
+    assert_eq!(
+        String::from_utf8(aus.stdout).unwrap(),
+        "{\"auftraege\":[\
+         {\"name\":\"job-a\",\"runden\":1,\"entscheidung\":\"accepted\",\"kosten\":0.3},\
+         {\"name\":\"job-b\",\"runden\":1,\"entscheidung\":\"rejected\",\"kosten\":0.5},\
+         {\"name\":\"job-c\",\"runden\":0,\"entscheidung\":\"-\",\"kosten\":1}\
+         ],\"gesamt\":{\"auftraege\":3,\"angenommen\":1,\"kosten\":1.8}}\n"
+    );
+
+    // ohne Option unverändert
+    let aus = starte(&[w.as_os_str()]);
+    assert_eq!(
+        String::from_utf8(aus.stdout).unwrap(),
+        "job-a\t1\taccepted\t0.30\n\
+         job-b\t1\trejected\t0.50\n\
+         job-c\t0\t-\t1.00\n\
