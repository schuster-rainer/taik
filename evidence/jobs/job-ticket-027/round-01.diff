+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Output};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+static ZAEHLER: AtomicUsize = AtomicUsize::new(0);
+
+struct TempOrdner(PathBuf);
+
+impl TempOrdner {
+    fn neu() -> TempOrdner {
+        let nanos = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|d| d.as_nanos())
+            .unwrap_or(0);
+        let pfad = std::env::temp_dir().join(format!(
+            "auftragsbericht-test-{}-{}-{}",
+            std::process::id(),
+            nanos,
+            ZAEHLER.fetch_add(1, Ordering::SeqCst)
+        ));
+        fs::create_dir_all(&pfad).unwrap();
+        TempOrdner(pfad)
+    }
+}
+
+impl Drop for TempOrdner {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+fn schreibe(pfad: &Path, inhalt: &str) {
+    if let Some(eltern) = pfad.parent() {
+        fs::create_dir_all(eltern).unwrap();
+    }
+    fs::write(pfad, inhalt).unwrap();
+}
+
+fn starte(args: &[&std::ffi::OsStr]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_auftragsbericht"))
+        .args(args)
+        .output()
+        .unwrap()
+}
+
+#[test]
+fn zaehlung_und_ausgabe() {
+    let t = TempOrdner::neu();
+    let w = &t.0;
+
+    // job-a: zwei Runden, höchste Runde ist 10 (nicht 02)
+    schreibe(
+        &w.join("job-a/round-02.run"),
+        "decision=rejected\nworker_cost_usd=1.00\n",
+    );
+    schreibe(
+        &w.join("job-a/round-10.run"),
+        "decision=accepted\nworker_cost_usd=2.00\nsession_listed_usd=0.25\n",
+    );
+    schreibe(&w.join("job-a/extra.run"), "session_listed_usd=0.50\n");
+    schreibe(&w.join("job-a/notiz.txt"), "worker_cost_usd=100\n");
+    schreibe(&w.join("job-a/round-3.run"), "decision=x\nworker_cost_usd=foo\n");
+
+    // job-b: eine Runde
+    schreibe(
+        &w.join("job-b/round-01.run"),
+        "decision=rejected\nworker_cost_usd=0.5\n",
+    );
+
+    // job-c: keine Runde, aber Kosten
+    schreibe(&w.join("job-c/sonst.run"), "worker_cost_usd=1\n");
+
+    // wird übergangen
+    schreibe(&w.join("anders/round-01.run"), "decision=accepted\nworker_cost_usd=9\n");
+    schreibe(&w.join("job-datei"), "decision=accepted\n");
+
+    let aus = starte(&[w.as_os_str()]);
+    assert!(aus.status.success(), "{:?}", aus);
+    let stdout = String::from_utf8(aus.stdout).unwrap();
+    assert_eq!(
+        stdout,
+        "job-a\t2\taccepted\t3.75\n\
+         job-b\t1\trejected\t0.50\n\
+         job-c\t0\t-\t1.00\n\
+         gesamt\t3\t1\t5.25\n"
+    );
+}
+
+#[test]
+fn leerer_ordner() {
+    let t = TempOrdner::neu();
+    let aus = starte(&[t.0.as_os_str()]);
+    assert_eq!(aus.status.code(), Some(0));
+    assert_eq!(String::from_utf8(aus.stdout).unwrap(), "gesamt\t0\t0\t0.00\n");
+}
+
+#[test]
+fn falscher_aufruf() {
+    let aus = starte(&[]);
+    assert_eq!(aus.status.code(), Some(2));
+    assert!(String::from_utf8_lossy(&aus.stderr).contains("Aufruf: auftragsbericht ORDNER"));
+
+    let a = std::ffi::OsStr::new("a");
+    let b = std::ffi::OsStr::new("b");
+    let aus = starte(&[a, b]);
+    assert_eq!(aus.status.code(), Some(2));
+    assert!(String::from_utf8_lossy(&aus.stderr).contains("Aufruf: auftragsbericht ORDNER"));
+}
+
+#[test]
+fn kein_ordner() {
+    let t = TempOrdner::neu();
+    let fehlt = t.0.join("gibt-es-nicht");
+    let aus = starte(&[fehlt.as_os_str()]);
+    assert_eq!(aus.status.code(), Some(1));
+    assert!(aus.stdout.is_empty());
+    assert!(!aus.stderr.is_empty());
+
+    let datei = t.0.join("datei");
+    fs::write(&datei, "x").unwrap();
+    let aus = starte(&[datei.as_os_str()]);
+    assert_eq!(aus.status.code(), Some(1));
+    assert!(aus.stdout.is_empty());
+    assert!(!aus.stderr.is_empty());
+}
