+//! Zusammenfassung der Auftragsordner einer Factory.
+
+use std::fs;
+use std::io;
+use std::path::Path;
+
+/// Ergebnis der Zählung für einen Auftragsordner.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Auftrag {
+    pub name: String,
+    pub runden: usize,
+    pub entscheidung: String,
+    pub kosten: f64,
+}
+
+/// Inhalt eines einzelnen Protokolls.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Protokoll {
+    pub decision: Option<String>,
+    pub kosten: f64,
+}
+
+/// Liefert die Rundennummer, wenn der Dateiname genau `round-NN.run` ist.
+pub fn rundennummer(name: &str) -> Option<u32> {
+    let ziffern = name.strip_prefix("round-")?.strip_suffix(".run")?;
+    if ziffern.len() == 2 && ziffern.bytes().all(|b| b.is_ascii_digit()) {
+        ziffern.parse().ok()
+    } else {
+        None
+    }
+}
+
+/// Ist der Dateiname ein Protokoll (Endung `.run`)?
+pub fn ist_protokoll(name: &str) -> bool {
+    name.ends_with(".run")
+}
+
+/// Wandelt einen Wert in eine Zahl; alles, was keine endliche Zahl ist, zählt als 0.
+pub fn zahl(wert: &str) -> f64 {
+    match wert.trim().parse::<f64>() {
+        Ok(x) if x.is_finite() => x,
+        _ => 0.0,
+    }
+}
+
+/// Liest den Text eines Protokolls aus Zeilen `schlüssel=wert`.
+pub fn lies_protokoll(text: &str) -> Protokoll {
+    let text = text.strip_prefix('\u{feff}').unwrap_or(text);
+    let mut decision = None;
+    let mut kosten = 0.0;
+    for zeile in text.lines() {
+        let Some((schluessel, wert)) = zeile.split_once('=') else {
+            continue;
+        };
+        let wert = wert.trim();
+        match schluessel.trim() {
+            "decision" => decision = Some(wert.to_string()),
+            "worker_cost_usd" | "session_listed_usd" => kosten += zahl(wert),
+            _ => {}
+        }
+    }
+    Protokoll { decision, kosten }
+}
+
+/// Formatiert einen Betrag mit genau zwei Nachkommastellen.
+pub fn betrag(x: f64) -> String {
+    let s = format!("{:.2}", x);
+    if s == "-0.00" {
+        "0.00".to_string()
+    } else {
+        s
+    }
+}
+
+/// Zählt einen Auftragsordner aus.
+pub fn zaehle_auftrag(name: &str, pfad: &Path) -> io::Result<Auftrag> {
+    let mut runden = 0usize;
+    let mut hoechste: Option<(u32, Option<String>)> = None;
+    let mut kosten = 0.0;
+
+    for eintrag in fs::read_dir(pfad)? {
+        let eintrag = eintrag?;
+        let dateiname = eintrag.file_name();
+        let Some(dateiname) = dateiname.to_str() else {
+            continue;
+        };
+        if !ist_protokoll(dateiname) {
+            continue;
+        }
+        let dateipfad = eintrag.path();
+        if !fs::metadata(&dateipfad)?.is_file() {
+            continue;
+        }
+        let bytes = fs::read(&dateipfad).map_err(|e| {
+            io::Error::new(e.kind(), format!("{}: {}", dateipfad.display(), e))
+        })?;
+        let protokoll = lies_protokoll(&String::from_utf8_lossy(&bytes));
+        kosten += protokoll.kosten;
+
+        if let Some(nr) = rundennummer(dateiname) {
+            runden += 1;
+            if hoechste.as_ref().map_or(true, |(h, _)| nr > *h) {
+                hoechste = Some((nr, protokoll.decision));
+            }
+        }
+    }
+
+    let entscheidung = match hoechste {
+        Some((_, Some(d))) if !d.is_empty() => d,
+        _ => "-".to_string(),
+    };
+
+    Ok(Auftrag {
+        name: name.to_string(),
+        runden,
+        entscheidung,
+        kosten,
+    })
+}
+
+/// Zählt alle Auftragsordner (`job-*`) in `ordner`, sortiert nach Name.
+pub fn zaehle_ordner(ordner: &Path) -> io::Result<Vec<Auftrag>> {
+    let mut auftraege = Vec::new();
+    for eintrag in fs::read_dir(ordner)? {
+        let eintrag = eintrag?;
+        let name = eintrag.file_name();
+        let Some(name) = name.to_str() else {
+            continue;
+        };
+        if !name.starts_with("job-") {
+            continue;
+        }
+        let pfad = eintrag.path();
+        match fs::metadata(&pfad) {
+            Ok(m) if m.is_dir() => {}
+            _ => continue,
+        }
+        let auftrag = zaehle_auftrag(name, &pfad).map_err(|e| {
+            io::Error::new(e.kind(), format!("{}: {}", pfad.display(), e))
+        })?;
+        auftraege.push(auftrag);
+    }
+    auftraege.sort_by(|a, b| a.name.cmp(&b.name));
+    Ok(auftraege)
+}
+
+/// Erzeugt den Bericht einschließlich der Zeile `gesamt`.
+pub fn bericht(auftraege: &[Auftrag]) -> String {
+    let mut aus = String::new();
+    let mut summe = 0.0;
+    let mut angenommen = 0usize;
+    for a in auftraege {
+        aus.push_str(&format!(
+            "{}\t{}\t{}\t{}\n",
+            a.name,
+            a.runden,
+            a.entscheidung,
+            betrag(a.kosten)
+        ));
+        summe += a.kosten;
+        if a.entscheidung == "accepted" {
+            angenommen += 1;
+        }
+    }
+    aus.push_str(&format!(
+        "gesamt\t{}\t{}\t{}\n",
+        auftraege.len(),
+        angenommen,
+        betrag(summe)
+    ));
+    aus
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rundennamen() {
+        assert_eq!(rundennummer("round-01.run"), Some(1));
+        assert_eq!(rundennummer("round-12.run"), Some(12));
+        assert_eq!(rundennummer("round-1.run"), None);
+        assert_eq!(rundennummer("round-123.run"), None);
+        assert_eq!(rundennummer("round-ab.run"), None);
+        assert_eq!(rundennummer("round-01.txt"), None);
+        assert_eq!(rundennummer("xround-01.run"), None);
+    }
+
+    #[test]
+    fn protokoll_lesen() {
+        let p = lies_protokoll(
+            "decision=accepted\nworker_cost_usd=1.25\nsession_listed_usd=abc\nsession_listed_usd=0.5\r\nother=7\n",
+        );
+        assert_eq!(p.decision.as_deref(), Some("accepted"));
+        assert!((p.kosten - 1.75).abs() < 1e-9);
+    }
+
+    #[test]
+    fn keine_zahl_zaehlt_null() {
+        assert_eq!(zahl("x"), 0.0);
+        assert_eq!(zahl(""), 0.0);
+        assert_eq!(zahl("inf"), 0.0);
+        assert_eq!(zahl("NaN"), 0.0);
+        assert_eq!(zahl("2.5"), 2.5);
+    }
+
+    #[test]
+    fn betraege() {
+        assert_eq!(betrag(0.0), "0.00");
+        assert_eq!(betrag(4.25), "4.25");
+        assert_eq!(betrag(0.5), "0.50");
+        assert_eq!(betrag(-0.0001), "0.00");
+    }
+
+    #[test]
+    fn bericht_leer() {
+        assert_eq!(bericht(&[]), "gesamt\t0\t0\t0.00\n");
+    }
+}
