+use std::env;
+use std::fs;
+use std::io::{self, Write};
+use std::path::PathBuf;
+use std::process::ExitCode;
+
+fn main() -> ExitCode {
+    let args: Vec<_> = env::args_os().skip(1).collect();
+    if args.len() != 1 {
+        eprintln!("Aufruf: auftragsbericht ORDNER");
+        return ExitCode::from(2);
+    }
+    let ordner = PathBuf::from(&args[0]);
+
+    match fs::metadata(&ordner) {
+        Ok(m) if m.is_dir() => {}
+        Ok(_) => {
+            eprintln!(
+                "auftragsbericht: {} ist kein Ordner",
+                ordner.display()
+            );
+            return ExitCode::from(1);
+        }
+        Err(e) => {
+            eprintln!(
+                "auftragsbericht: {} kann nicht gelesen werden: {}",
+                ordner.display(),
+                e
+            );
+            return ExitCode::from(1);
+        }
+    }
+
+    let auftraege = match auftragsbericht::zaehle_ordner(&ordner) {
+        Ok(a) => a,
+        Err(e) => {
+            eprintln!("auftragsbericht: Lesefehler: {}", e);
+            return ExitCode::from(1);
+        }
+    };
+
+    let text = auftragsbericht::bericht(&auftraege);
+    let mut aus = io::stdout().lock();
+    if aus.write_all(text.as_bytes()).and_then(|_| aus.flush()).is_err() {
+        return ExitCode::from(1);
+    }
+    ExitCode::SUCCESS
+}
