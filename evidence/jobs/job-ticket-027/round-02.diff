+#[test]
+fn offen_leerer_ordner() {
+    let t = TempOrdner::neu();
+    let offen = std::ffi::OsStr::new("--offen");
+    let aus = starte(&[offen, t.0.as_os_str()]);
+    assert_eq!(aus.status.code(), Some(0));
+    assert_eq!(String::from_utf8(aus.stdout).unwrap(), "gesamt\t0\t0\t0.00\n");
+}
+
+#[test]
+fn unbekannte_option() {
+    let t = TempOrdner::neu();
+    for opt in ["--zu", "-x", "--offen=ja"] {
+        let o = std::ffi::OsStr::new(opt);
+        let aus = starte(&[o, t.0.as_os_str()]);
+        assert_eq!(aus.status.code(), Some(2), "{}", opt);
+        assert!(aus.stdout.is_empty());
+        assert!(String::from_utf8_lossy(&aus.stderr).contains("Aufruf: auftragsbericht ORDNER"));
+    }
+    // nur die Option, kein Ordner
+    let aus = starte(&[std::ffi::OsStr::new("--offen")]);
+    assert_eq!(aus.status.code(), Some(2));
+}
