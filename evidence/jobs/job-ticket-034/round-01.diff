+#[test]
+fn json_leerer_ordner() {
+    let t = TempOrdner::neu();
+    let json = std::ffi::OsStr::new("--json");
+    let offen = std::ffi::OsStr::new("--offen");
+    let erwartet =
+        "{\"auftraege\":[],\"gesamt\":{\"auftraege\":0,\"angenommen\":0,\"kosten\":0}}\n";
+
+    let aus = starte(&[json, t.0.as_os_str()]);
+    assert_eq!(aus.status.code(), Some(0));
+    assert_eq!(String::from_utf8(aus.stdout).unwrap(), erwartet);
+
+    let aus = starte(&[json, offen, t.0.as_os_str()]);
+    assert_eq!(aus.status.code(), Some(0));
+    assert_eq!(String::from_utf8(aus.stdout).unwrap(), erwartet);
+}
