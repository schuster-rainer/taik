+#[test]
+fn json_fehler() {
+    let t = TempOrdner::neu();
+    let json = std::ffi::OsStr::new("--json");
+
+    // ohne Ordner
+    let aus = starte(&[json]);
+    assert_eq!(aus.status.code(), Some(2));
+    assert!(String::from_utf8_lossy(&aus.stderr).contains("Aufruf: auftragsbericht ORDNER"));
+
+    // zwei Ordner
+    let aus = starte(&[json, t.0.as_os_str(), t.0.as_os_str()]);
+    assert_eq!(aus.status.code(), Some(2));
+    assert!(String::from_utf8_lossy(&aus.stderr).contains("Aufruf: auftragsbericht ORDNER"));
+
+    // unbekannte Option
+    let aus = starte(&[std::ffi::OsStr::new("--json=ja"), t.0.as_os_str()]);
+    assert_eq!(aus.status.code(), Some(2));
+    assert!(aus.stdout.is_empty());
+
+    // Ordner fehlt
+    let fehlt = t.0.join("gibt-es-nicht");
+    let aus = starte(&[json, fehlt.as_os_str()]);
+    assert_eq!(aus.status.code(), Some(1));
+    assert!(aus.stdout.is_empty());
+}
