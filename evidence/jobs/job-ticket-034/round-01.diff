+#[test]
+fn beispiel_json() {
+    let t = TempOrdner::neu();
+    beispiel(&t.0);
+    let json = std::ffi::OsStr::new("--json");
+    let offen = std::ffi::OsStr::new("--offen");
+
+    let aus = starte(&[json, t.0.as_os_str()]);
+    assert_eq!(aus.status.code(), Some(0), "{:?}", aus);
+    assert_eq!(String::from_utf8(aus.stdout).unwrap(), JSON_ALLE);
+
+    for args in [[json, offen], [offen, json]] {
+        let aus = starte(&[args[0], args[1], t.0.as_os_str()]);
+        assert_eq!(aus.status.code(), Some(0), "{:?}", aus);
+        let stdout = String::from_utf8(aus.stdout).unwrap();
+        assert_eq!(stdout, JSON_OFFEN);
+        assert_eq!(stdout.lines().count(), 1);
+    }
+}
