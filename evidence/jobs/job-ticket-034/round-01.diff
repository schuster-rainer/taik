+/// Maskiert eine Zeichenkette als JSON-Zeichenkette (einschließlich Anführungszeichen).
+pub fn json_text(s: &str) -> String {
+    let mut aus = String::with_capacity(s.len() + 2);
+    aus.push('"');
+    for c in s.chars() {
+        match c {
+            '"' => aus.push_str("\\\""),
+            '\\' => aus.push_str("\\\\"),
+            '\n' => aus.push_str("\\n"),
+            '\r' => aus.push_str("\\r"),
+            '\t' => aus.push_str("\\t"),
+            '\u{08}' => aus.push_str("\\b"),
+            '\u{0c}' => aus.push_str("\\f"),
+            c if (c as u32) < 0x20 || c == '\u{7f}' => {
+                aus.push_str(&format!("\\u{:04x}", c as u32));
+            }
+            c => aus.push(c),
+        }
+    }
+    aus.push('"');
+    aus
+}
+
+/// Formatiert einen Betrag als JSON-Zahl mit höchstens zwei Nachkommastellen
+/// (überflüssige Nullen entfallen, z. B. `0.5`, `0`).
+pub fn json_betrag(x: f64) -> String {
+    let s = betrag(x);
+    let s = s.trim_end_matches('0').trim_end_matches('.');
+    if s.is_empty() || s == "-" {
+        "0".to_string()
+    } else {
+        s.to_string()
+    }
+}
+
+/// Erzeugt den Bericht als einzeiliges JSON-Objekt mit Zeilenende.
+pub fn bericht_json(auftraege: &[Auftrag]) -> String {
+    let mut aus = String::from("{\"auftraege\":[");
+    let mut summe = 0.0;
+    let mut angenommen = 0usize;
+    for (i, a) in auftraege.iter().enumerate() {
+        if i > 0 {
+            aus.push(',');
+        }
+        aus.push_str(&format!(
+            "{{\"name\":{},\"runden\":{},\"entscheidung\":{},\"kosten\":{}}}",
+            json_text(&a.name),
+            a.runden,
+            json_text(&a.entscheidung),
+            json_betrag(a.kosten)
+        ));
+        summe += a.kosten;
+        if a.entscheidung == "accepted" {
+            angenommen += 1;
+        }
+    }
+    aus.push_str(&format!(
+        "],\"gesamt\":{{\"auftraege\":{},\"angenommen\":{},\"kosten\":{}}}}}\n",
+        auftraege.len(),
+        angenommen,
+        json_betrag(summe)
+    ));
+    aus
+}
